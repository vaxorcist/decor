<%# decor/app/views/computer_statistics/index.html.erb - version 1.2 %>
<%# v1.2: UI rename — column header "Model" -> "Computer Model" for clarity. %>
<%#   No data change; @stats[:model] still refers to a ComputerModel record. %>
<%# v1.1 (Session 61): Compact table layout; zero-count models no longer rendered. %>
<%#   Table is now w-auto (shrinks to content) instead of min-w-full so the %>
<%#   "Registered Computers" column sits close to the "Computer Model" column rather than %>
<%#   being pushed to the far right of the container. %>
<%#   Count column is left-aligned with pl-10 (40px) padding — creates a small, %>
<%#   readable gap without the wide empty expanse of a right-aligned full-width table. %>
<%#   The zero-count branch is removed; the controller excludes count-0 entries. %>
<%# v1.0 (Session 61): New view — Computers Statistics page. %>

<div class="grid grid-cols-4 gap-6 items-start px-6 py-4">

  <%# Left column — filter sidebar (col-span-1 applied inside the partial). %>
  <%= render "filters" %>

  <%# Right three columns — statistics table. %>
  <div class="col-span-3">

    <h1 class="text-2xl font-bold text-stone-900 mb-6">Computers Statistics</h1>

    <% if @stats.empty? %>
      <p class="text-stone-500">No computer models found.</p>
    <% else %>
      <%# w-auto: table shrinks to its content width instead of stretching to the %>
      <%# full container, so the count column sits immediately after the model names. %>
      <table class="w-auto">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="pb-2 pr-2 text-left text-xs font-medium text-stone-500 uppercase tracking-wider">Computer Model</th>
            <%# pl-10 (40px) creates a modest visual gap between the two columns. %>
            <th class="pb-2 pl-10 text-left text-xs font-medium text-stone-500 uppercase tracking-wider whitespace-nowrap">Registered Computers</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @stats.each do |stat| %>
            <tr class="hover:bg-stone-50">

              <%# Computer Model name — always a link (zero-count models excluded by the controller). %>
              <%# Clicking through pre-filters the computers index to this model. %>
              <td class="py-3 pr-2 text-sm">
                <%= link_to stat[:model].name,
                            computers_path(model: stat[:model].id),
                            class: "text-indigo-600 hover:text-indigo-900" %>
              </td>

              <%# Count — left-aligned, pl-10 matches the header padding. %>
              <td class="py-3 pl-10 text-sm font-medium text-stone-900">
                <%= stat[:count] %>
              </td>

            </tr>
          <% end %>
        </tbody>

        <%# Footer row — total across all currently displayed models. %>
        <tfoot>
          <tr class="border-t border-stone-200">
            <td class="pt-3 pr-2 text-xs font-medium text-stone-500 uppercase tracking-wider">Total</td>
            <td class="pt-3 pl-10 text-sm font-medium text-stone-900">
              <%= @stats.sum { |s| s[:count] } %>
            </td>
          </tr>
        </tfoot>
      </table>
    <% end %>

  </div><%# end col-span-3 %>

</div><%# end grid %>
