<%# decor/app/views/layouts/admin.html.erb %>
<%# version 2.7 %>
<%# v2.7 (Session 67): Added "Download Manual Changes" to the Components dropdown, %>
<%#   after "Download Unvalidated Order Numbers". CSV of every component_suggestions %>
<%#   row flagged manual: "added" or "modified" (both together, one download — %>
<%#   confirmed Session 66). This is the required backup step before running a %>
<%#   re-import, since ComponentSuggestionImportService v2.0 deletes ALL rows %>
<%#   (including manually-flagged ones) unconditionally with no automatic %>
<%#   preservation. Links to download_manual_admin_component_suggestions_path — %>
<%#   generated by the `collection do get :download_manual end` block nested %>
<%#   inside `resources :component_suggestions` (routes.rb v3.6). VERIFIED via %>
<%#   `bin/rails routes | grep download_manual`: for a collection route on a %>
<%#   resources block already inside namespace :admin, Rails names the route %>
<%#   "download_manual_admin_component_suggestions" — the action name is %>
<%#   PREPENDED to the already-admin_-prefixed resource name, not appended %>
<%#   after it like the plain admin_component_suggestions_path index route. %>
<%#   This is a DIFFERENT prefixing shape than the Session 65 as: routes %>
<%#   (revalidate_component_order_numbers etc., which get admin_ prepended to %>
<%#   a name that already ends in the resource name) — worth remembering as a %>
<%#   second, distinct case of "don't assume the helper name, verify it." %>
<%#   Uses the same data-turbo="false" pattern as "Download Unvalidated Order %>
<%#   Numbers" and the Imports/Exports export form — plain GET file download; %>
<%#   Turbo must not intercept it or the send_data response is silently dropped. %>
<%# v2.6 (Session 65 fix): Both new path helpers were missing their "admin_" %>
<%#   prefix in v2.5, causing a NameError at render time. Custom named routes %>
<%#   declared with as: inside `namespace :admin do ... end` are STILL prefixed %>
<%#   with "admin_" by Rails — exactly like every other admin:: route in this %>
<%#   file (e.g. `as: :data_transfer` inside the namespace yields %>
<%#   admin_data_transfer_path, not data_transfer_path). Fixed both links to %>
<%#   use admin_revalidate_component_order_numbers_path and %>
<%#   admin_unvalidated_component_order_numbers_path. %>
<%# v2.5 (Session 65): Added two Component order_number bulk-maintenance items %>
<%#   to the Components dropdown: "Re-validate Order Numbers" (POST action, %>
<%#   applies immediately, confirm dialog) and "Download Unvalidated Order %>
<%#   Numbers" (GET, CSV file download, data-turbo="false" so Turbo doesn't %>
<%#   intercept and drop the send_data response — same pattern as the export %>
<%#   form on admin/data_transfers/show.html.erb). Backed by the new %>
<%#   Admin::ComponentOrderNumbersController (routes.rb v3.5). %>
<%# v2.4 (Session 64): Added "Component Suggestions" to the Components dropdown, %>
<%#   linking to admin_component_suggestions_path. This was a gap left over from %>
<%#   Session 63 Phase 1 — the admin CRUD controller/views were shipped but this %>
<%#   layout was never updated to link to them, so the feature had no menu entry. %>
<%# v2.3 (Session 56): Added "Newsletters" dropdown between Software and Imports/Exports. %>
<%#   Two items: "Upload Newsletter" (new_admin_newsletter_path) and %>
<%#   "Send Newsletter" (admin_newsletters_path — opens the index, each row has Send). %>
<%# v2.2 (Session 53): Texts dropdown — added "Download Text" between Upload and Delete. %>
<%# v2.1 (Session 44): Software feature Session B. %>
<%# v2.0 (Session 41): Appliances → Peripherals merger Phase 2. %>
<%# v1.9 (Session 33): Added "Connections" dropdown after Components. %>
<%# v1.8 (Session 25): Added "Peripherals" dropdown between Appliances and Components. %>
<%# v1.7 (Session 24): Import/Export dropdown renamed to "Imports/Exports". %>
<%# v1.6 (Session 23): Owners dropdown: added "Invite Owner" link. %>
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - DEC Owner's Registry" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Decor">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-100 min-h-screen text-stone-900">
    <nav class="bg-white border-b border-stone-200">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex justify-between h-14">

          <%# ── Left side: dropdown menus ───────────────────────────────── %>
          <div class="flex items-center space-x-1 text-sm">

            <%# ── Owners ─────────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Owners
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Manage Owners", admin_owners_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Invite Owner", new_admin_invite_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Pending Invites", admin_invites_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Computers ───────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Computers
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Computer Models", admin_computer_models_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Computer Conditions", admin_conditions_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Run Statuses", admin_run_statuses_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Peripherals ─────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Peripherals
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Peripheral Models", admin_peripheral_models_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Components ──────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Components
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Component Types", admin_component_types_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Run Statuses", admin_component_conditions_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%# Component Suggestions — admin-managed order_number autocomplete lookup table. %>
                <%# Added Session 64 (was missing from this menu since the Session 63 Phase 1 %>
                <%# admin CRUD was shipped without a corresponding navigation update). %>
                <%= link_to "Component Suggestions", admin_component_suggestions_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%# Re-validate Order Numbers — added Session 65. POST action; re-syncs %>
                <%# EVERY component's order_number_verified against the current %>
                <%# component_suggestions table. Applies immediately (no preview step — %>
                <%# confirmed design decision), so a turbo_confirm dialog is the only %>
                <%# guard against an accidental click. %>
                <%= link_to "Re-validate Order Numbers", admin_revalidate_component_order_numbers_path,
                      data: { turbo_method: :post,
                              turbo_confirm: "Re-check every component's order number against the Component Suggestions table now?" },
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%# Download Unvalidated Order Numbers — added Session 65. Plain GET file %>
                <%# download (one row per component whose order_number_verified is false). %>
                <%# data-turbo="false" required: Turbo intercepts GET link clicks and %>
                <%# silently drops send_data file responses otherwise — same issue %>
                <%# documented on the Imports/Exports export form in %>
                <%# admin/data_transfers/show.html.erb. %>
                <%= link_to "Download Unvalidated Order Numbers", admin_unvalidated_component_order_numbers_path,
                      data: { turbo: false },
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%# Download Manual Changes — added Session 67 (Phase 4 item 2). Plain GET %>
                <%# file download of every component_suggestions row flagged manual: "added" %>
                <%# or "modified" (both together, one CSV — confirmed Session 66). This is %>
                <%# the required backup step before running a re-import, since %>
                <%# ComponentSuggestionImportService v2.0 deletes ALL rows unconditionally, %>
                <%# including manually-flagged ones, with no automatic preservation. Same %>
                <%# data-turbo="false" reasoning as "Download Unvalidated Order Numbers" above. %>
                <%= link_to "Download Manual Changes", download_manual_admin_component_suggestions_path,
                      data: { turbo: false },
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Connections ─────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Connections
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Connection Types", admin_connection_types_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Software ────────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Software
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Software Names", admin_software_names_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Software Conditions", admin_software_conditions_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Newsletters ─────────────────────────────────────────────── %>
            <%# Added Session 56. Positioned between Software and Imports/Exports. %>
            <%# Two items: Upload Newsletter (new) and Send Newsletter (index → Send). %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Newsletters
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%# Upload Newsletter: admin provides subject + .md file. %>
                <%= link_to "Upload Newsletter", new_admin_newsletter_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%# Send Newsletter: goes to index; each row has a "Send" action. %>
                <%# The index also shows "Send" as a per-row action. %>
                <%= link_to "Send Newsletter", admin_newsletters_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Imports/Exports ─────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Imports/Exports
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Exports", admin_data_transfer_path(anchor: "export"),
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Imports", admin_data_transfer_path(anchor: "import"),
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

            <%# ── Texts ───────────────────────────────────────────────────── %>
            <div class="relative" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="flex items-center gap-1 px-3 py-2 font-medium text-stone-700
                             hover:text-stone-900 hover:bg-stone-50 rounded">
                Texts
                <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute top-full left-0 mt-1 bg-white border border-stone-200
                          rounded shadow-md py-1 z-50 min-w-max">
                <%= link_to "Upload Text", new_admin_site_text_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Download Text", download_confirm_admin_site_texts_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
                <%= link_to "Delete Text", delete_confirm_admin_site_texts_path,
                      class: "block px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 hover:text-stone-900" %>
              </div>
            </div>

          </div><%# end left side %>

          <%# ── Right side: Exit Admin ──────────────────────────────────── %>
          <div class="flex items-center text-sm">
            <%= link_to "Exit Admin", root_path,
                  class: "font-medium text-stone-700 hover:text-stone-900" %>
          </div>

        </div>
      </div>
    </nav>

    <% if flash[:notice] %>
      <div class="bg-stone-50 border-b border-stone-200">
        <div class="mx-auto max-w-7xl px-6 py-3 text-sm text-stone-700 border-l-2 border-stone-400">
          <%= flash[:notice] %>
        </div>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="bg-stone-50 border-b border-stone-200">
        <div class="mx-auto max-w-7xl px-6 py-3 text-sm text-stone-700 border-l-2 border-stone-600">
          <%= flash[:alert] %>
        </div>
      </div>
    <% end %>

    <main class="mx-auto max-w-7xl px-6 py-6">
      <%= yield %>
    </main>
  </body>
</html>
