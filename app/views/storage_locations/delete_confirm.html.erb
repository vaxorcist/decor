<%# decor/app/views/storage_locations/delete_confirm.html.erb - version 1.1 %>
<%# Session C (Storage Locations feature, Part 3 of 6): replaces Session %>
<%# B's interim, count-less confirmation with a real affected-record %>
<%# counts warning, now that @computers_count / @components_count / %>
<%# @software_items_count are set by the controller (storage_locations_controller.rb %>
<%# v1.1#delete_confirm), backed by StorageLocation's new has_many :nullify %>
<%# associations (storage_location.rb v1.1). Only shows a warning line for %>
<%# a category that actually has a nonzero count — an owner with a never- %>
<%# used location shouldn't see three "0 items" lines cluttering the page. %>
<%# %>
<%# Delete link pattern unchanged from v1.0, matches %>
<%# admin/site_texts/delete_confirm.html.erb v1.1's precedent: data: %>
<%# { turbo_method: :delete, turbo_confirm: ... } on a plain link, NOT %>
<%# wrapped in any data-turbo="false" ancestor (RAILS_SPECIFICS.md %>
<%# "data-turbo='false' — NEVER wrap Turbo-method links inside it" — this %>
<%# file has no such wrapper, so that trap doesn't apply here). %>

<% affected_total = @computers_count + @components_count + @software_items_count %>

<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-semibold mb-6">Delete Storage Location</h1>

  <div class="mb-6 p-3 bg-amber-50 border border-amber-200 rounded text-sm text-amber-800">
    <p class="mb-2">
      Delete "<strong><%= @storage_location.name %></strong>"? This cannot be undone.
    </p>

    <% if affected_total > 0 %>
      <p class="mb-1">The following will be set to no location (they will NOT be deleted):</p>
      <ul class="list-disc list-inside">
        <% if @computers_count > 0 %>
          <li><%= pluralize(@computers_count, "computer/peripheral", plural: "computers/peripherals") %></li>
        <% end %>
        <% if @components_count > 0 %>
          <li><%= pluralize(@components_count, "component") %></li>
        <% end %>
        <% if @software_items_count > 0 %>
          <li><%= pluralize(@software_items_count, "software item") %></li>
        <% end %>
      </ul>
    <% else %>
      <p>Nothing currently uses this storage location — it can be deleted freely.</p>
    <% end %>
  </div>

  <div class="flex gap-3 items-center">
    <%= link_to "Delete",
          storage_location_path(@storage_location),
          data: { turbo_method: :delete,
                  turbo_confirm: "Delete this storage location? This cannot be undone." },
          class: "#{button_classes(style: :primary)} bg-red-600 hover:bg-red-700" %>
    <%= link_to "Cancel", storage_locations_path, class: button_classes(style: :secondary) %>
  </div>
</div>
