<%# decor/app/views/computers/new.html.erb - version 1.6 %>
<%# v1.6 (Session 75 redelivery): Updated the required-fields notice text. %>
<%#   Stale since Session 70's Owner Part Number feature made both %>
<%#   serial_number and owner_part_number default to "-" via %>
<%#   before_validation rather than serial_number alone being hard- %>
<%#   required (see DECOR_PROJECT.md "Owner Part Number Feature — Sessions %>
<%#   69–72"). Notice now reflects the actual constraint that matters: the %>
<%#   combined uniqueness scope requires at least one of DEC Serial Number %>
<%#   or Owner Part Number to be a real, non-default value. The device_type %>
<%#   label (Computer Model / Peripheral Model) was already dynamic via %>
<%#   @computer.device_type.capitalize (v1.4/v1.5) and needed no further %>
<%#   change — this single edit covers both /computers/new and %>
<%#   /computers/new?device_type=peripheral. %>
<%# v1.5 (Session 74): Fixed a hardcoded "Computer Model" string in the %>
<%#   required-fields notice — same regression as computers/_form.html.erb %>
<%#   v2.9 (see its changelog for the full explanation): the Session 69 UI %>
<%#   Terminology rename introduced "Computer Model" as a static string, %>
<%#   never accounting for device_type: peripheral. The <h1> two lines %>
<%#   above this notice already correctly used %>
<%#   @computer.device_type.capitalize (added Session 18, v1.4) — this %>
<%#   notice just hadn't been updated to match when the rename landed. %>
<%# v1.4 (Session 18): Heading now uses @computer.device_type.capitalize for %>
<%#   consistency with edit.html.erb (v1.3). Defaults to "Add Computer" since %>
<%#   Computer.new defaults device_type to 0 (computer). %>
<%# v1.3 (Session 10): Added Stimulus Back button below form, matching components/edit pattern. %>

<div class="max-w-5xl mx-auto">
  <h1 class="text-2xl font-semibold mb-4">Add <%= @computer.device_type.capitalize %></h1>

  <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded text-sm text-blue-800">
    <strong>Required fields:</strong> <%= @computer.device_type.capitalize %> Model and at least one of
    DEC Serial Number and Owner Part Number. Components can be added after saving.
  </div>

  <%= render "form", computer: @computer %>

  <%# Stimulus Back button — history.back() primary; computers index as fallback %>
  <div class="mt-4">
    <a href="#"
       data-controller="back"
       data-back-fallback-url-value="<%= computers_path %>"
       data-action="click->back#go"
       class="text-sm text-stone-700 hover:text-stone-900">← Back</a>
  </div>
</div>
