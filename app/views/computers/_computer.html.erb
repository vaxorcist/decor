<%# decor/app/views/computers/_computer.html.erb - version 1.13 %>
<%# v1.13 (Session C, Storage Locations feature, Part 3 of 6): Added the %>
<%#   "Storage Location" cell matching the header added in index.html.erb %>
<%#   v1.12. PRIVACY: this partial is shared across every row on a PUBLIC %>
<%#   index (any visitor, any other owner). The cell only reveals the real %>
<%#   storage_location name when Current.owner == computer.owner (the %>
<%#   viewer is looking at their OWN device) — every other row shows a %>
<%#   plain em-dash, regardless of whether that computer actually has a %>
<%#   location assigned. This is deliberately stricter than the Barter %>
<%#   column's "if logged_in?" guard, which shows real barter data to ANY %>
<%#   logged-in member for ANY row — Storage Location must never leak %>
<%#   another owner's value even to other logged-in members. First pass %>
<%#   consistent with the Session 79 privacy design; DECOR_PROJECT.md %>
<%#   Session D still owns the dedicated audit. %>
<%# v1.12 (Session 71): Owner Part Number feature — added the missing "Owner %>
<%#   Part Number" cell, matching the header added in index.html.erb v1.11. %>
<%#   This partial is shared by both /computers and /peripherals (same %>
<%#   controller, device_context-scoped). Placed after DEC Serial Number, %>
<%#   matching computers/_form.html.erb v2.7's field order. NOT NULL column — %>
<%#   .presence || "—" pattern kept for defensive consistency with the %>
<%#   neighbouring DEC Part/Serial Number cells, even though owner_part_number %>
<%#   always has a value ("-" at minimum) once the Session 70 migration runs. %>
<%# v1.11: UI rename — updated inline comments to match the renamed column %>
<%#   headers in index.html.erb v1.10 ("Model" -> "Computer Model", %>
<%#   "Order Number" -> "DEC Part Number", "Serial Number" -> "DEC Serial %>
<%#   Number"). Comment-only change; no cell markup or data affected. %>
<%# v1.10 (Session 22): Removed the Type column cell entirely. The Type column %>
<%#   header was removed from index.html.erb at the same time — the Computers page %>
<%#   always shows computers (type is implicit) and the Appliances page always shows %>
<%#   appliances, so the column was redundant on both routes. %>
<%# v1.9 (Session 21): Added "Barter" column (barter_status), visible to logged-in %>
<%#   members only. Cell and its matching header (index.html.erb) are both wrapped %>
<%#   in - if logged_in? - so the column is completely absent for visitors. %>
<%#   Offered → green text; Wanted → amber text; no_barter → em-dash. %>
<%#   Column position: after Run Status, before Actions. %>
<%# v1.8 (Session 17): Type column cell hidden when @device_context == "appliance". %>
<%# v1.7: Added "Type" column after Model. %>
<%# v1.6: computer.condition → computer.computer_condition. %>

<tr id="<%= dom_id computer %>" class="hover:bg-stone-50">
  <!-- Owner -->
  <td class="px-4 py-3 whitespace-nowrap text-stone-600">
    <%= link_to computer.owner.user_name, computer.owner, class: "text-indigo-600 hover:text-indigo-900" %>
  </td>

  <!-- Computer Model -->
  <td class="px-4 py-3 whitespace-nowrap font-medium text-stone-900">
    <%= link_to computer.computer_model.name, computer, class: "text-indigo-600 hover:text-indigo-900" %>
  </td>

  <!-- DEC Part Number -->
  <td class="px-4 py-3 whitespace-nowrap text-stone-600">
    <%= computer.order_number.presence || "—" %>
  </td>

  <!-- DEC Serial Number -->
  <td class="px-4 py-3 whitespace-nowrap text-stone-600">
    <%= computer.serial_number.presence || "—" %>
  </td>

  <!-- Owner Part Number -->
  <td class="px-4 py-3 whitespace-nowrap text-stone-600">
    <%= computer.owner_part_number.presence || "—" %>
  </td>

  <!-- Condition -->
  <td class="px-4 py-3 whitespace-nowrap text-stone-600">
    <%= computer.computer_condition&.name || "—" %>
  </td>

  <!-- Run Status -->
  <td class="px-4 py-3 whitespace-nowrap text-stone-600">
    <%= computer.run_status&.name || "—" %>
  </td>

  <%# Barter (barter_status) — members only; column absent entirely for visitors. %>
  <% if logged_in? %>
    <td class="px-4 py-3 whitespace-nowrap">
      <% if computer.barter_status_offered? %>
        <span class="text-green-700">Offered</span>
      <% elsif computer.barter_status_wanted? %>
        <span class="text-amber-600">Wanted</span>
      <% else %>
        <span class="text-stone-400">—</span>
      <% end %>
    </td>
  <% end %>

  <%# Storage Location — Session C. Own-row-only: never reveals another %>
  <%# owner's value, even to a logged-in viewer. See v1.13 header comment. %>
  <% if logged_in? %>
    <td class="px-4 py-3 whitespace-nowrap text-stone-600">
      <% if Current.owner == computer.owner %>
        <%= computer.storage_location&.name || "—" %>
      <% else %>
        <span class="text-stone-400">—</span>
      <% end %>
    </td>
  <% end %>

  <!-- Actions -->
  <td class="px-4 py-3 whitespace-nowrap text-right">
    <% if Current.owner == computer.owner %>
      <%= link_to "Edit", edit_computer_path(computer), class: "text-indigo-600 hover:text-indigo-900" %>
    <% end %>
  </td>
</tr>
