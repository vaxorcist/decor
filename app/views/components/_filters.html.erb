<%# decor/app/views/components/_filters.html.erb - version 1.5 %>
<%# v1.5 (Session 88, Storage Locations feature Session E — see %>
<%#   DECOR_PROJECT.md "Storage Locations Feature — Session Plan"): Added %>
<%#   the Storage Location filter select, gated by if logged_in? — same %>
<%#   guard as the Trade block above it, and for the same reason: storage %>
<%#   locations are private per-owner data (Session D privacy audit passed %>
<%#   with no code changes needed), so this filter must not appear at all %>
<%#   for logged-out visitors. Positioned after Trade, matching the exact %>
<%#   pattern established and pre-commit-verified in %>
<%#   computers/_filters.html.erb v1.8. %>
<%# v1.4 (Session 77): Follow-up to v1.3 — the user asked that DEC Part %>
<%#   Number (order_number) also be searchable, since it wasn't in the %>
<%#   field list v1.3 had just clarified. Added to component.rb's `search` %>
<%#   scope (v1.8) and to this file's help-text field list to match. Search %>
<%#   still does NOT cover serial_number or owner_part_number — not asked %>
<%#   for, and out of scope for this change. %>
<%# v1.3 (Session 77): Reported: unclear which fields the Search box %>
<%#   actually searches. Confirmed via component.rb's `search` scope %>
<%#   (v1.7): component type name, owner username, computer/peripheral %>
<%#   model name, and description — NOT order_number, serial_number, or %>
<%#   owner_part_number. Added a plain-language field list to the existing %>
<%#   help text below the input, so users don't have to guess (or read %>
<%#   source) to know what a search term will and won't match. No change %>
<%#   to the search scope itself or to the input's width — the existing %>
<%#   text-xs helper <p> already wraps onto multiple lines as needed at %>
<%#   this sidebar's width, so the extra sentence doesn't require layout %>
<%#   changes. %>
<%# v1.2 (Session 52): Added "Peripheral Model" filter after "Computer Model". %>
<%#   computer_model param — unchanged; now scoped to computer models only in helper. %>
<%#   peripheral_model param — new; handled by components_controller v1.9. %>
<%# v1.1 (Session 22): Added "Trade" barter_status filter at the bottom of the %>
<%#   sidebar, after Computer Model, before the Reset/Apply buttons. The entire %>
<%#   block is wrapped in - if logged_in? - so non-logged-in visitors never %>
<%#   see it. Helper methods: component_filter_barter_status_options / _selected %>
<%#   (defined in components_helper.rb v1.3). %>
<%# v1.0: Added wildcard usage tips for search functionality. %>

<%= form_with url: components_path, method: :get, local: true, class: "col-span-1 self-start flex flex-col gap-4 mb-4 p-4 bg-stone-100" do |form| %>
  <div class="-mb-2 font-medium">Filters</div>

  <div>
    <%= form.label :query, "Search", class: "text-sm text-stone-600 font-medium" %>
    <%= form.search_field :query, value: params[:query], placeholder: "Search...", class: field_classes %>
    <%# Session 77: field list added/updated — must stay in sync with %>
    <%# component.rb's `search` scope. %>
    <p class="text-xs text-stone-500 mt-1">Searches component type, owner username, computer/peripheral model, DEC Part Number, and description. Use % for any characters, _ for single character. Case-insensitive.</p>
  </div>

  <div class="flex flex-col">
    <%= form.label :sort, "Sort", class: "text-sm text-stone-600 font-medium" %>
    <%= form.select :sort, component_sort_options, { selected: component_sort_selected }, { class: field_classes } %>
  </div>

  <div class="flex flex-col">
    <%= form.label :component_type, "Type", class: "text-sm text-stone-600 font-medium" %>
    <%= form.select :component_type, component_filter_component_type_options, { selected: component_filter_component_type_selected, include_blank: "Any" }, { class: field_classes } %>
  </div>

  <div class="flex flex-col">
    <%= form.label :computer_model, "Computer Model", class: "text-sm text-stone-600 font-medium" %>
    <%= form.select :computer_model, component_filter_computer_model_options, { selected: component_filter_computer_model_selected, include_blank: "Any" }, { class: field_classes } %>
  </div>

  <div class="flex flex-col">
    <%= form.label :peripheral_model, "Peripheral Model", class: "text-sm text-stone-600 font-medium" %>
    <%= form.select :peripheral_model, component_filter_peripheral_model_options, { selected: component_filter_peripheral_model_selected, include_blank: "Any" }, { class: field_classes } %>
  </div>

  <%# Trade (barter_status) filter — visible to logged-in members only. %>
  <%# Non-logged-in visitors see no barter data anywhere; this block must be %>
  <%# completely absent (not just greyed out) for unauthenticated requests. %>
  <% if logged_in? %>
    <div class="flex flex-col">
      <%= form.label :barter_status, "Trade", class: "text-sm text-stone-600 font-medium" %>
      <%= form.select :barter_status, component_filter_barter_status_options, { selected: component_filter_barter_status_selected }, { class: field_classes } %>
    </div>
  <% end %>

  <%# Storage Location filter — visible to logged-in members only. %>
  <%# Storage locations are private per-owner data (Storage Locations feature, %>
  <%# Session D privacy audit) — this block, like Trade above, must be %>
  <%# completely absent (not just greyed out) for unauthenticated requests. %>
  <%# The options list is always Current.owner's OWN storage locations only — %>
  <%# see ComponentsHelper#component_filter_storage_locations_options. %>
  <% if logged_in? %>
    <div class="flex flex-col">
      <%= form.label :storage_location_id, "Storage Location", class: "text-sm text-stone-600 font-medium" %>
      <%= form.select :storage_location_id, component_filter_storage_locations_options, { selected: component_filter_storage_locations_selected, include_blank: "Any" }, { class: field_classes } %>
    </div>
  <% end %>

  <div class="flex justify-end gap-2">
    <%= link_to "Reset", components_path, class: button_classes(style: :secondary) %>
    <%= form.submit "Apply", class: button_classes(style: :secondary) %>
  </div>
<% end %>
