<%# v1.10 (Session 68): Edit Component UI change — removed the static "max-h-60" %>
<%#   class from the suggestion dropdown <ul>. Height is now set dynamically by %>
<%#   component_suggestion_controller.js v1.1 (_applyViewportAwareHeight) so the %>
<%#   dropdown can show more rows (endpoint limit raised 10 -> 100) while never %>
<%#   extending past the bottom of the viewport. No other markup changed — the %>
<%#   auto-accept-on-single-match removal and the bracketed description/category %>
<%#   format are entirely JS-side changes with no corresponding erb edit needed. %>
<%# v1.9 (Session 64): Component Suggestions Phase 2. %>
<%#   Wired the component-suggestion Stimulus controller onto the form_with tag, %>
<%#   with data-component-suggestion-url-value pointing at component_suggestions_path. %>
<%#   order_number field: added orderNumberInput target + input/keydown actions; %>
<%#   wrapped in a relative div so the absolutely-positioned dropdown <ul> overlays correctly. %>
<%#   Added hidden order_number_verified field (verifiedFlag target) — set true by the %>
<%#   controller when a suggestion is accepted, defaults to the persisted model value otherwise. %>
<%#   serial_number field: added serialNumberInput target (focus destination on accept). %>
<%#   description field: added descriptionInput target (pre-filled on accept if currently blank). %>
<%# v1.8 (Session 54): Added data-controller="tom-select" to component_type_id and %>
<%#   component_condition_id. %>
<%#   computer_id is intentionally excluded: it already carries data-controller="computer-select" %>
<%#   with focus/blur actions (openDropdown / closeDropdown). Tom Select hides the native %>
<%#   <select>, so those focus/blur events would never fire, breaking the collapse-to- %>
<%#   model-name behaviour managed by the computer-select controller. %>
<%# v1.7 (Session 52): Removed Component Category field. %>
<%#   Row 3 now contains only Trade Status (barter_status), single column. %>
<%#   :component_category removed from strong params in components_controller v1.8. %>
<%# v1.6 (Session 21): Added component_category and barter_status fields. %>
<%# v1.5 (Session 10 rev 2): Computer Model dropdown collapses to model name after selection. %>

<%# Capture owner's computers once — used for the dropdown options and the JSON map. %>
<%# Sorted alphabetically by model name (case-insensitive), ascending — Session 77. %>
<%# order_number/serial_number are tie-breakers only, for deterministic ordering %>
<%# when two devices share the same model; they don't affect the primary sort. %>
<% owner_computers = Current.owner.computers.includes(:computer_model).to_a
     .sort_by { |c| [c.computer_model.name.downcase, c.order_number.to_s, c.serial_number.to_s] } %>

<%# Build option array for f.select: [display_label, value, html_option_attributes] %>
<%# The full label (shown while browsing) is %>
<%# "Model  /  DEC Part Number  /  Owner Part Number  /  DEC Serial Number" %>
<%# (v1.14 — Owner Part Number added, positioned to match this file's own %>
<%# Row 2 field order for Components). %>
<%# data-model-name carries just the model name for the post-selection collapsed display. %>
<% computer_options = owner_computers.map { |c|
     full_label = [
       c.computer_model.name,
       c.order_number.presence       || "—",
       c.owner_part_number.presence  || "—",
       c.serial_number.presence      || "—"
     ].join("  /  ")
     [full_label, c.id, { data: { model_name: c.computer_model.name } }]
   } %>

<%# JSON map for auto-filling the read-only display fields. %>
<% computers_json = owner_computers.each_with_object({}) { |c, h|
     h[c.id.to_s] = {
       order_number:  c.order_number.to_s,
       serial_number: c.serial_number.to_s
     }
   }.to_json %>

<%= form_with model: component, class: "space-y-4",
      data: {
        controller: "component-suggestion",
        "component-suggestion-url-value": component_suggestions_path
      } do |f| %>
  <%= render "common/record_errors", record: component %>

  <%# ─── Row 1: Computer/Peripheral | Computer DEC Part Number | Computer DEC Serial Number ─── %>
  <%# %>
  <%# Stimulus controller wraps all three columns so it can reach all three targets. %>
  <%# data-computer-select-computers-value carries the JSON map for order/serial lookup. %>
  <%# %>
  <%# NOTE: Tom Select is NOT applied to the computer_id select here. That select %>
  <%# carries data-controller="computer-select" with focus/blur actions that manage %>
  <%# the collapse-to-model-name display. Tom Select hides the native element, which %>
  <%# would silence those focus/blur events and break the collapse behaviour. %>
  <div class="grid grid-cols-[3fr_2fr_2fr] gap-4"
       data-controller="computer-select"
       data-computer-select-computers-value="<%= computers_json %>">

    <%# Computer/Peripheral: f.select (not collection_select) so options can carry %>
    <%# data-model-name for the post-selection collapsed display. %>
    <%# Three data-action events wired: change (pick), focus (open), blur (close). %>
    <div>
      <%= f.label :computer_id, "Computer/Peripheral", class: "block text-sm font-medium text-stone-700" %>
      <%= f.select :computer_id,
            computer_options,
            { include_blank: "Spare (not attached to a computer/peripheral)" },
            class: field_classes,
            data: {
              "computer-select-target": "computerSelect",
              action: [
                "change->computer-select#change",
                "focus->computer-select#openDropdown",
                "blur->computer-select#closeDropdown"
              ].join(" ")
            } %>
      <p class="mt-1 text-xs text-stone-500">Leave blank if this is a spare component not attached to a computer/peripheral.</p>
    </div>

    <%# Computer DEC Part Number — read-only, auto-filled by Stimulus. %>
    <%# No name attribute: must not be submitted (value belongs to the Computer record). %>
    <div>
      <label class="block text-sm font-medium text-stone-700">Computer DEC Part Number</label>
      <input type="text"
             readonly
             tabindex="-1"
             placeholder="—"
             data-computer-select-target="orderNumber"
             class="w-full h-10 p-3 rounded border border-stone-300 bg-stone-50 text-sm text-stone-400 cursor-not-allowed">
      <p class="mt-1 text-xs text-stone-500">Auto-filled from the selected device.</p>
    </div>

    <%# Computer DEC Serial Number — read-only, auto-filled by Stimulus. %>
    <div>
      <label class="block text-sm font-medium text-stone-700">Computer DEC Serial Number</label>
      <input type="text"
             readonly
             tabindex="-1"
             placeholder="—"
             data-computer-select-target="serialNumber"
             class="w-full h-10 p-3 rounded border border-stone-300 bg-stone-50 text-sm text-stone-400 cursor-not-allowed">
      <p class="mt-1 text-xs text-stone-500">Auto-filled from the selected device.</p>
    </div>
  </div>

  <%# ─── Row 2: Component Type | Component DEC Part Number | Component Owner Part Number | Component DEC Serial Number | Condition ─── %>
  <%# Widened Session 70 from grid-cols-4 to grid-cols-5 to fit the new Owner Part Number field. %>
  <%# %>
  <%# v1.13 label-height fix: at grid-cols-5 width, "Component DEC Part Number", %>
  <%# "Component Owner Part Number", and "Component DEC Serial Number" wrap to two %>
  <%# lines while "Component Type" and "Run Status" stay on one line — this %>
  <%# staggered the input boxes below them. Every label in this row now carries %>
  <%# "flex items-end min-h-[2.5rem]": a fixed two-line-tall box (text-sm line-height %>
  <%# is 1.25rem/line) with the label text bottom-anchored inside it, so a %>
  <%# one-line label sits flush with the bottom of the same box a two-line label %>
  <%# fills completely — every input starts at the same y regardless of how many %>
  <%# lines its own label wrapped to. %>
  <div class="grid grid-cols-5 gap-4">
    <div>
      <%= f.label :component_type_id, "Component Type", class: "flex items-end min-h-[2.5rem] text-sm font-medium text-stone-700" %>
      <%# Tom Select applied: searchable, consistent UX with model selects elsewhere. %>
      <%= f.collection_select :component_type_id,
            ComponentType.order(:name),
            :id, :name,
            { prompt: "Select a type" },
            class: field_classes,
            data: { controller: "tom-select" } %>
    </div>

    <div class="relative">
      <%= f.label :order_number, "Component DEC Part Number", class: "flex items-end min-h-[2.5rem] text-sm font-medium text-stone-700" %>
      <%# Hidden field tracks whether the current order_number came from an %>
      <%# accepted suggestion. Defaults to the persisted value so editing an %>
      <%# existing verified component doesn't silently reset the flag unless %>
      <%# the user actually changes the order_number field. %>
      <%= f.hidden_field :order_number_verified, data: { "component-suggestion-target": "verifiedFlag" } %>
      <%= f.text_field :order_number, maxlength: 20, class: field_classes,
            autocomplete: "off",
            data: {
              "component-suggestion-target": "orderNumberInput",
              action: [
                "input->component-suggestion#onInput",
                "keydown->component-suggestion#onKeydown"
              ].join(" ")
            } %>
      <%# Dropdown list rendered by the Stimulus controller. Starts hidden; %>
      <%# absolutely positioned so it overlays content below without shifting layout. %>
      <%# v1.10 (Session 68): static "max-h-60" removed — the JS controller now sets %>
      <%# an inline max-height on render (component_suggestion_controller.js v1.1, %>
      <%# _applyViewportAwareHeight), computed from the remaining space between this %>
      <%# input and the bottom of the viewport, so the dropdown (which can now hold %>
      <%# up to 100 rows, up from 10) never extends past the bottom of the page. %>
      <%# "overflow-auto" is kept as a class since scrolling is still always wanted; %>
      <%# only the height cap moved from a static class to a dynamic inline style. %>
      <ul data-component-suggestion-target="dropdown"
          class="hidden absolute z-10 w-full mt-1 bg-white border border-stone-300 rounded shadow-lg overflow-auto"></ul>
      <p class="mt-1 text-xs text-stone-500">Maximum 20 characters.</p>
    </div>

    <%# Component Owner Part Number — Session 70. Plain text field, no typeahead. %>
    <%# Defaults to "-" server-side (component.rb before_validation) if left blank — %>
    <%# not pre-filled here so an intentionally-blank submission still shows the %>
    <%# placeholder default consistently rather than duplicating that logic in the view. %>
    <div>
      <%= f.label :owner_part_number, "Component Owner Part Number", class: "flex items-end min-h-[2.5rem] text-sm font-medium text-stone-700" %>
      <%= f.text_field :owner_part_number, maxlength: 20, class: field_classes,
            placeholder: "-" %>
      <p class="mt-1 text-xs text-stone-500">Maximum 20 characters. Defaults to "-" if left blank.</p>
    </div>

    <div>
      <%= f.label :serial_number, "Component DEC Serial Number", class: "flex items-end min-h-[2.5rem] text-sm font-medium text-stone-700" %>
      <%= f.text_field :serial_number, maxlength: 20, class: field_classes,
            placeholder: "-",
            data: { "component-suggestion-target": "serialNumberInput" } %>
      <p class="mt-1 text-xs text-stone-500">Maximum 20 characters. Defaults to "-" if left blank.</p>
    </div>

    <div>
      <%= f.label :component_condition_id, "Run Status", class: "flex items-end min-h-[2.5rem] text-sm font-medium text-stone-700" %>
      <%# Tom Select applied: searchable, consistent UX. %>
      <%= f.collection_select :component_condition_id,
            ComponentCondition.order(:condition),
            :id, :condition,
            { include_blank: "Unknown" },
            class: field_classes,
            data: { controller: "tom-select" } %>
    </div>
  </div>

  <%# ─── Row 3: Trade Status ─── %>
  <%# component_category removed in v1.7 — field is no longer editable on this form. %>
  <%# barter_status: no_barter (default), offered, or wanted. %>
  <%# Native select kept: only 3 options — Tom Select adds no value at this size. %>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :barter_status, "Trade Status", class: "block text-sm font-medium text-stone-700" %>
      <%= f.select :barter_status,
            [["No Trade", "no_barter"], ["Offered", "offered"], ["Wanted", "wanted"]],
            {},
            class: field_classes %>
      <p class="mt-1 text-xs text-stone-500">Visible to members only.</p>
    </div>

    <%# Storage Location — Session C. Private field, own list only. %>
    <%# Optional — belongs_to :storage_location, optional: true (component.rb v1.9). %>
    <div>
      <%= f.label :storage_location_id, "Storage Location", class: "block text-sm font-medium text-stone-700" %>
      <%= f.collection_select :storage_location_id,
            Current.owner.storage_locations.order(:name),
            :id, :name,
            { include_blank: "No location assigned" },
            class: field_classes %>
      <p class="mt-1 text-xs text-stone-500">Optional. Manage your list under "My Storage Locations".</p>
    </div>
  </div>

  <%# ─── Row 4: Description — full width ─── %>
  <div>
    <%= f.label :description, "Component Description", class: "block text-sm font-medium text-stone-700" %>
    <%= f.text_area :description, rows: 4, style: "min-height: 4.5rem;", class: field_classes,
          data: { "component-suggestion-target": "descriptionInput" } %>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: button_classes(style: :primary) %>
    <% unless component.persisted? %>
      <%= f.submit "Create and add another", name: "add_another", class: button_classes(style: :secondary) %>
    <% end %>
    <%# "Done" instead of "Cancel" — no implication of reverting a prior action. %>
    <%= link_to "Done", (component.persisted? ? component_path(component) : components_path), class: button_classes(style: :secondary) %>
  </div>
<% end %>
