<%# decor/app/views/shared/_newsletter_email_chrome.html.erb %>
<%# version 2.1 %>
<%# Session 57: Four fixes to the newsletter email chrome. %>
<%#   1. Logo: base64-encoded PNG hardcoded directly in the partial as a constant. %>
<%#      Zero runtime file I/O, no path dependency, no conditional — the image is %>
<%#      always self-contained in both the email and the admin preview. %>
<%#   2. Table inline styles: Nokogiri injects style= attributes directly onto %>
<%#      <table>, <th>, and <td> elements generated by Redcarpet. This survives %>
<%#      both Tailwind preflight (admin preview) and aggressive email-client CSS %>
<%#      stripping (Gmail etc.) — class-based <style> rules alone do not. %>
<%#   3. Table header color: changed from #f5f5f4 (stone-100, barely visible) to %>
<%#      #d6d3d1 (stone-300, clearly distinct from the white cell background). %>
<%#   4. Column padding: increased from 6px 12px to 8px 18px for comfortable %>
<%#      reading width between columns. %>
<%# %>
<%# Single source of truth for the newsletter email layout. %>
<%# Rendered by: %>
<%#   - app/views/mailers/newsletter_mailer/send_newsletter.html.erb (actual email) %>
<%#   - app/views/admin/newsletters/show.html.erb (admin preview) %>
<%# %>
<%# Locals: %>
<%#   html_body  [String]  — rendered HTML content, {{user_name}} already substituted %>
<%#                          (mailer) or shown as-is (preview). %>
<%# %>
<%# Logo strategy: the PNG is embedded as a static base64 constant. No disk read, %>
<%# no path lookup, no conditional. Works identically in development, production, %>
<%# letter_opener (file:// pages), and every email client. %>
<%# %>
<%# Table inline styles strategy: Nokogiri processes html_body after Redcarpet %>
<%# renders it. Style attributes are added directly to each table element. This %>
<%# is the only approach that reliably survives: %>
<%#   a) Tailwind CSS preflight (resets all table styling in the admin preview) %>
<%#   b) Email client CSS stripping (Gmail removes <style> blocks entirely) %>
<%# The class-based rules in the <style> block below are kept as a secondary layer %>
<%# for clients that DO support them (most desktop email clients, webmail with CSS). %>

<%# ── Logo constant ────────────────────────────────────────────────────────── %>
<%# PNG encoded at build time — no runtime file access needed. %>
<% NEWSLETTER_LOGO_SRC ||= "data:image/png;base64,".freeze %>

<%# ── Table inline-style injection ─────────────────────────────────────────── %>
<%# Nokogiri is always available as a Rails dependency. Using HTML.fragment (not %>
<%# HTML::Document) so no <!DOCTYPE> or <html><body> wrappers are added. %>
<%# The rescue ensures a Nokogiri failure never breaks email delivery — it falls %>
<%# back to the original html_body. %>
<% styled_body = begin
     doc = Nokogiri::HTML.fragment(html_body)

     # Tables: collapse borders, full width, vertical rhythm.
     doc.css("table").each do |t|
       t["style"] = "border-collapse: collapse; width: 100%; margin: 16px 0; font-size: 14px;"
     end

     # Header cells: clearly distinct background (stone-300), solid border, generous padding.
     doc.css("th").each do |th|
       th["style"] = "background-color: #d6d3d1; border: 1px solid #a8a29e; " \
                     "padding: 8px 18px; text-align: left; font-weight: 600; color: #1c1917;"
     end

     # Data cells: solid border on all sides, comfortable horizontal padding.
     # Only patch td elements that currently have no style attribute
     # (i.e. the Redcarpet-generated ones, not the outer wrapper table cells).
     doc.css("td").each do |td|
       td["style"] = "border: 1px solid #d6d3d1; padding: 8px 18px;" unless td["style"]
     end

     # Alternating row tint: apply to every even <tr> in <tbody>.
     doc.css("tbody tr:nth-child(even) td").each do |td|
       td["style"] = "border: 1px solid #d6d3d1; padding: 8px 18px; background-color: #fafaf9;"
     end

     doc.to_html.html_safe
   rescue StandardError
     # Fallback: return original body unmodified if Nokogiri processing fails.
     html_body.html_safe
   end %>

<%# ── Styles ──────────────────────────────────────────────────────────────── %>
<%# Secondary layer for clients that honour <style> tags (most desktop clients, %>
<%# many webmail apps). Gmail and a few others strip this — inline styles above %>
<%# cover those clients. Placing <style> here (not in <head>) means it travels %>
<%# with the partial in both the mailer and the admin preview. %>
<style type="text/css">
  /* Typography */
  .newsletter-body { font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.7; }
  .newsletter-body h1 { font-size: 24px; font-weight: bold; margin: 20px 0 8px; }
  .newsletter-body h2 { font-size: 20px; font-weight: bold; margin: 20px 0 8px; }
  .newsletter-body h3 { font-size: 17px; font-weight: bold; margin: 16px 0 6px; }
  .newsletter-body p  { margin: 10px 0; }
  .newsletter-body ul { padding-left: 24px; margin: 10px 0; list-style: disc; }
  .newsletter-body ol { padding-left: 24px; margin: 10px 0; list-style: decimal; }

  /* Tables — matches the inline values set by Nokogiri above. */
  .newsletter-body table  { border-collapse: collapse; width: 100%; margin: 16px 0; font-size: 14px; }
  .newsletter-body th     { background-color: #d6d3d1; border: 1px solid #a8a29e; padding: 8px 18px; text-align: left; font-weight: 600; color: #1c1917; }
  .newsletter-body td     { border: 1px solid #d6d3d1; padding: 8px 18px; }
  .newsletter-body tr:nth-child(even) td { background-color: #fafaf9; }

  /* Inline code and pre blocks */
  .newsletter-body code   { background-color: #f5f5f4; padding: 2px 5px; border-radius: 3px; font-size: 13px; font-family: monospace; }
  .newsletter-body pre    { background-color: #f5f5f4; padding: 12px 16px; border-radius: 4px; }

  /* Links and rules */
  .newsletter-body a      { color: #44403c; }
  .newsletter-body hr     { border: none; border-top: 1px solid #e7e5e4; margin: 16px 0; }
</style>

<%# ── Outer wrapper ───────────────────────────────────────────────────────── %>
<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background-color: #f5f5f4; padding: 32px 0;">
  <tr>
    <td align="center">
      <table width="900" cellpadding="0" cellspacing="0" border="0"
             style="background-color: #ffffff; border: 1px solid #e7e5e4;
                    border-radius: 4px; overflow: hidden;">

        <%# ── Header ─────────────────────────────────────────────────────── %>
        <tr>
          <td style="background-color: #f5f5f4; border-bottom: 1px solid #e7e5e4;
                     padding: 16px 32px;">
            <table cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="vertical-align: middle; padding-right: 10px;">
                  <img src="<%= NEWSLETTER_LOGO_SRC %>"
                       alt="DECOR"
                       style="display: block; border: 0; height: 40px; width: auto;">
                </td>
                <td style="vertical-align: middle;">
                  <span style="font-family: Arial, Helvetica, sans-serif;
                               font-size: 24px; color: #1c1917; line-height: 1.4;">
                    — DEC Owner's Registry
                  </span>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <%# ── Body ───────────────────────────────────────────────────────── %>
        <%# styled_body is trusted admin-supplied content rendered by Redcarpet  %>
        <%# and post-processed by Nokogiri to add inline styles. html_safe is    %>
        <%# correct here — html_safe is already applied inside the styled_body   %>
        <%# block above.                                                           %>
        <tr>
          <td class="newsletter-body"
              style="padding: 32px; color: #1c1917; font-size: 16px; line-height: 1.7;
                     font-family: Arial, Helvetica, sans-serif;">
            <%= styled_body %>
          </td>
        </tr>

        <%# ── Footer ─────────────────────────────────────────────────────── %>
        <tr>
          <td style="background-color: #fafaf9; border-top: 1px solid #e7e5e4;
                     padding: 20px 32px;">
            <p style="margin: 0; font-size: 12px; color: #78716c;
                       font-family: Arial, Helvetica, sans-serif;">
              You are receiving this email because you are a member of the
              DEC Owner's Registry. To unsubscribe, log in to your account
              and update your newsletter preference.
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
