<%# decor/app/views/admin/newsletters/new.html.erb %>
<%# version 1.0 %>
<%# Session 56: Newsletter feature — upload form. %>
<%# %>
<%# The admin provides: %>
<%#   1. A subject line (text field, required). %>
<%#   2. A markdown file (.md) to upload (file field, required). %>
<%# %>
<%# {{user_name}} placeholder note is shown so the admin knows the convention. %>
<%# The file is read server-side in the controller; html_body is generated by %>
<%# Newsletter#before_save via Redcarpet (same config as ApplicationHelper). %>

<div class="max-w-xl mx-auto">
  <div class="mb-4 flex items-center gap-3">
    <h1 class="text-2xl font-semibold">Upload Newsletter</h1>
    <%= link_to "← Back to Newsletters", admin_newsletters_path,
          class: "text-sm text-stone-600 hover:text-stone-900 ml-auto" %>
  </div>

  <%# multipart: true is required for file uploads. %>
  <%= form_with model: @newsletter, url: admin_newsletters_path,
        multipart: true, class: "space-y-5" do |f| %>
    <%= render "common/record_errors", record: @newsletter %>

    <%# Subject line ──────────────────────────────────────────────────────── %>
    <div>
      <%= f.label :subject, "Subject", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= f.text_field :subject, required: true, class: field_classes,
            placeholder: "e.g. DEC Owner's Registry — April 2026 Newsletter" %>
      <p class="mt-1 text-xs text-stone-500">This will appear as the email subject line.</p>
    </div>

    <%# Markdown file upload ───────────────────────────────────────────────── %>
    <div>
      <label class="block text-sm font-medium text-stone-700 mb-1">
        Markdown file (.md)
      </label>
      <%# f.file_field does not use field_classes because file inputs need accept. %>
      <%= f.file_field :md_file, accept: ".md,text/markdown,text/plain",
            class: "block w-full text-sm text-stone-700
                    file:mr-3 file:py-2 file:px-4 file:rounded
                    file:border-0 file:text-sm file:font-medium
                    file:bg-stone-100 file:text-stone-700
                    hover:file:bg-stone-200" %>
      <p class="mt-1 text-xs text-stone-500">
        Upload a <code>.md</code> file. The content will be converted to HTML automatically
        using the same renderer as the site text pages.
      </p>
    </div>

    <%# {{user_name}} placeholder hint ───────────────────────────────────── %>
    <div class="bg-stone-50 border border-stone-200 rounded p-4 text-sm text-stone-700">
      <p class="font-medium mb-1">Personalisation placeholder</p>
      <p>
        Use <code class="bg-stone-100 px-1 rounded">{{user_name}}</code> anywhere
        in the markdown to insert each recipient's username automatically when the
        newsletter is sent.
      </p>
      <p class="mt-2 text-stone-500 text-xs">
        Example: <code>Dear {{user_name}},</code> — becomes <em>Dear jsmith,</em> for owner jsmith.
      </p>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Upload Newsletter", class: button_classes(style: :primary) %>
      <%= link_to "Cancel", admin_newsletters_path, class: button_classes(style: :secondary) %>
    </div>
  <% end %>
</div>
