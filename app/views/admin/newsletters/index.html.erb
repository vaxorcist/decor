<%# decor/app/views/admin/newsletters/index.html.erb %>
<%# version 1.0 %>
<%# Session 56: Newsletter feature — list all stored newsletters. %>
<%# %>
<%# Columns: Subject, Uploaded (created_at), subscriber count, row actions. %>
<%# Actions per row: Preview, Send, Delete. %>

<div class="max-w-5xl mx-auto">
  <div class="mb-4 flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Newsletters</h1>
    <%= link_to "Upload Newsletter", new_admin_newsletter_path,
          class: "inline-flex items-center px-4 py-2 text-sm font-medium
                  bg-stone-800 text-white rounded hover:bg-stone-900" %>
  </div>

  <% if @newsletters.empty? %>
    <div class="bg-white border border-stone-200 rounded p-8 text-center text-stone-500 text-sm">
      No newsletters have been uploaded yet.
    </div>
  <% else %>
    <div class="bg-white border border-stone-200 rounded">
      <table class="min-w-full divide-y divide-stone-200">
        <thead class="bg-stone-50">
          <tr>
            <th class="px-4 py-2 text-left text-xs font-medium text-stone-500 uppercase tracking-wider">Subject</th>
            <th class="px-4 py-2 text-left text-xs font-medium text-stone-500 uppercase tracking-wider">Uploaded</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-stone-200 text-sm">
          <% @newsletters.each do |newsletter| %>
            <tr>
              <td class="px-4 py-3 font-medium text-stone-800">
                <%= link_to newsletter.subject, admin_newsletter_path(newsletter),
                      class: "hover:text-stone-600" %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-stone-600">
                <%= newsletter.created_at.strftime("%d %b %Y %H:%M") %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right space-x-3">
                <%# Preview: shows rendered HTML body in the admin show view. %>
                <%= link_to "Preview", admin_newsletter_path(newsletter),
                      class: "text-stone-700 hover:text-stone-900 text-sm" %>
                <%# Send: opens recipient-selection form. %>
                <%= link_to "Send", send_newsletter_admin_newsletter_path(newsletter),
                      class: "text-stone-700 hover:text-stone-900 text-sm" %>
                <%# Delete: requires confirmation before destroying the record. %>
                <%= button_to "Delete", admin_newsletter_path(newsletter),
                      method: :delete,
                      data: { turbo_confirm: "Delete \"#{newsletter.subject}\"? This cannot be undone." },
                      class: "text-stone-700 hover:text-stone-900 text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
