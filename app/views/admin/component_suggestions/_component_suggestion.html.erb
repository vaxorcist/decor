<%# decor/app/views/admin/component_suggestions/_component_suggestion.html.erb %>
<%# version 1.0 %>
<%# Session 67: Phase 4 item 4 — extracted from index.html.erb v1.0's inline %>
<%# <tr> so both index.html.erb (initial page load) and index.turbo_stream.erb %>
<%# ("Load more" appends) can render an identical row from the same source, %>
<%# instead of duplicating the markup in two places. Matches the established %>
<%# row-partial pattern used by software_items/_software_item.html.erb. %>
<%# %>
<%# Locals: %>
<%#   suggestion — a ComponentSuggestion instance %>
<%# %>
<%# Added the "Manual" column (Session 67, Phase 4 item 1): shows "Added" / %>
<%# "Modified" (humanized from the manual enum) or an em-dash for untouched %>
<%# bulk-import rows (manual: nil) — same "—" convention already used for %>
<%# blank description/category in this table. %>

<tr id="component_suggestion_<%= suggestion.id %>">
  <td class="py-2 pr-6 font-mono text-stone-800"><%= suggestion.order_number %></td>
  <td class="py-2 pr-6 text-stone-600"><%= suggestion.description.presence || "—" %></td>
  <td class="py-2 pr-6 text-stone-600"><%= suggestion.category.presence || "—" %></td>
  <td class="py-2 pr-6 text-stone-600"><%= suggestion.manual&.humanize || "—" %></td>
  <td class="py-2 space-x-4 whitespace-nowrap">
    <%= link_to "Edit",
                edit_admin_component_suggestion_path(suggestion),
                class: "text-indigo-600 hover:text-indigo-900" %>
    <%= link_to "Delete",
                admin_component_suggestion_path(suggestion),
                data: { turbo_method: :delete,
                        turbo_confirm: "Delete #{suggestion.order_number}? This cannot be undone." },
                class: "text-red-600 hover:text-red-900" %>
  </td>
</tr>
