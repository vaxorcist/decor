<%# decor/app/views/admin/component_suggestions/index.html.erb %>
<%# version 1.0 %>
<%# Session 63: Phase 1 of Component Suggestions feature. %>
<%# %>
<%# Lists all ComponentSuggestion records in a table ordered by order_number. %>
<%# Includes New, Edit, and Delete actions. %>
<%# Pattern: mirrors admin/software_names/index.html.erb. %>

<div class="max-w-4xl mx-auto mt-8 px-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-stone-800">Component Suggestions</h1>
    <%= link_to "New Component Suggestion",
                new_admin_component_suggestion_path,
                class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded hover:bg-indigo-700" %>
  </div>

  <% if @component_suggestions.any? %>
    <table class="w-full text-sm text-left">
      <thead>
        <tr class="border-b border-stone-200">
          <th class="pb-2 pr-6 text-stone-500 uppercase text-xs font-medium">Order Number</th>
          <th class="pb-2 pr-6 text-stone-500 uppercase text-xs font-medium">Description</th>
          <th class="pb-2 pr-6 text-stone-500 uppercase text-xs font-medium">Category</th>
          <th class="pb-2 text-stone-500 uppercase text-xs font-medium">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @component_suggestions.each do |suggestion| %>
          <tr>
            <td class="py-2 pr-6 font-mono text-stone-800"><%= suggestion.order_number %></td>
            <td class="py-2 pr-6 text-stone-600"><%= suggestion.description.presence || "—" %></td>
            <td class="py-2 pr-6 text-stone-600"><%= suggestion.category.presence || "—" %></td>
            <td class="py-2 space-x-4 whitespace-nowrap">
              <%= link_to "Edit",
                          edit_admin_component_suggestion_path(suggestion),
                          class: "text-indigo-600 hover:text-indigo-900" %>
              <%= link_to "Delete",
                          admin_component_suggestion_path(suggestion),
                          data: { turbo_method: :delete,
                                  turbo_confirm: "Delete #{suggestion.order_number}? This cannot be undone." },
                          class: "text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-stone-500 mt-4">No component suggestions yet. Add one or import a CSV file.</p>
  <% end %>
</div>
