<%# decor/app/views/admin/component_suggestions/_form.html.erb %>
<%# version 1.0 %>
<%# Session 63: Phase 1 of Component Suggestions feature. %>
<%# %>
<%# Shared form partial for new and edit actions. %>
<%# Pattern: mirrors admin/software_names/_form.html.erb. %>

<%= form_with model: [:admin, component_suggestion], class: "space-y-5 max-w-lg" do |f| %>
  <% if component_suggestion.errors.any? %>
    <div class="rounded bg-red-50 border border-red-200 p-4 text-sm text-red-700">
      <p class="font-medium mb-1">
        <%= pluralize(component_suggestion.errors.count, "error") %> prevented this record from being saved:
      </p>
      <ul class="list-disc list-inside space-y-0.5">
        <% component_suggestion.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# order_number — required, max 20 chars, unique %>
  <div>
    <%= f.label :order_number, "Order Number", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_field :order_number,
                     maxlength: 20,
                     class: "w-full border border-stone-300 rounded px-3 py-2 text-sm font-mono
                             focus:outline-none focus:ring-1 focus:ring-indigo-500",
                     placeholder: "e.g. DELQA or M7516" %>
    <p class="mt-1 text-xs text-stone-400">Max 20 characters. Must be unique.</p>
  </div>

  <%# description — optional, max 100 chars %>
  <div>
    <%= f.label :description, "Description", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_field :description,
                     maxlength: 100,
                     class: "w-full border border-stone-300 rounded px-3 py-2 text-sm
                             focus:outline-none focus:ring-1 focus:ring-indigo-500",
                     placeholder: "e.g. DELQA Ethernet Controller" %>
    <p class="mt-1 text-xs text-stone-400">Optional. Max 100 characters. Pre-fills the component description field.</p>
  </div>

  <%# category — optional, max 40 chars, informational only %>
  <div>
    <%= f.label :category, "Category", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_field :category,
                     maxlength: 40,
                     class: "w-full border border-stone-300 rounded px-3 py-2 text-sm
                             focus:outline-none focus:ring-1 focus:ring-indigo-500",
                     placeholder: "e.g. Option, Module, Assembly, Part" %>
    <p class="mt-1 text-xs text-stone-400">Optional. Shown in dropdown for context only — not stored on the component.</p>
  </div>

  <div class="flex gap-4">
    <%= f.submit "Save Component Suggestion",
                 class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded
                         hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Done", admin_component_suggestions_path,
                class: "px-4 py-2 text-sm font-medium text-stone-600 hover:text-stone-900" %>
  </div>
<% end %>
